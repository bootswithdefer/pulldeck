# Maintainer: bootswithdefer
#
# Builds pulldeck from a release tag. To update: set pkgver to the new release, run
# `updpkgsums`, then `makepkg -si`. `packaging/aur/README.md` has the details.
pkgname=pulldeck
pkgver=0.1.1
pkgrel=1
pkgdesc='GitHub pull request tracker for KDE and other desktops (Rust + Qt)'
arch=('x86_64' 'aarch64')
url='https://github.com/bootswithdefer/pulldeck'
license=('MIT')
depends=('qt6-base' 'qt6-declarative')
makedepends=('cargo' 'clang' 'lld')
optdepends=(
  'github-cli: sign in to GitHub with `gh auth login` instead of a token variable'
  'gnome-keyring: remember a pulldeck server sign-in (any Secret Service provider works)'
  'kwallet: remember a pulldeck server sign-in (via its Secret Service)'
)
# makepkg's default LTO compiles the C++ bridge code to GCC bitcode, which rust-lld cannot link.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('6fde5465c8bd70a38a123a3f82139d2dbb6cd76d90e6123c2ede93d3c2153c42')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p pulldeck
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p pulldeck-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/pulldeck "$pkgdir/usr/bin/pulldeck"
  install -Dm644 packaging/pulldeck.desktop "$pkgdir/usr/share/applications/pulldeck.desktop"
  # Releases before 0.1.2 have no icon.
  if [ -f packaging/pulldeck.svg ]; then
    install -Dm644 packaging/pulldeck.svg \
      "$pkgdir/usr/share/icons/hicolor/scalable/apps/pulldeck.svg"
  fi
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
